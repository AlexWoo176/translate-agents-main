{
  "schemaVersion": "1.0",
  "workflowId": "openstax-vn-translation-workflow",
  "name": "OpenStax Vietnamese Translation Workflow",
  "description": "Machine-readable workflow definition for translating OpenStax books into Vietnamese.",
  "version": "1.0.0",
  "defaultBookStructure": {
    "bookRoot": "books/{bookSlug}",
    "chaptersRoot": "books/{bookSlug}/chapters",
    "bookLevelRoot": "books/{bookSlug}/_book-level"
  },
  "phases": [
    {
      "id": "plan",
      "name": "Plan translation project",
      "order": 1,
      "description": "Create or validate book-level translation plan and workflow tasks.",
      "agent": "agent-plan",
      "scope": ["book"],
      "inputPhases": [],
      "outputPhase": "planning",
      "inputPaths": ["book.config.json"],
      "outputPaths": ["tasks.md", "workflow-state.json"],
      "qualityGate": "planCompleteness",
      "requiresHumanApproval": true,
      "canRunAutomatically": false,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "scrape",
      "name": "Scrape OpenStax source HTML",
      "order": 2,
      "description": "Fetch raw source HTML and assets from OpenStax.",
      "agent": "agent-scrape",
      "scope": ["book", "chapter", "book-level"],
      "inputPhases": ["plan"],
      "outputPhase": "raw",
      "inputPaths": ["book.config.json"],
      "outputPaths": ["01-raw", "assets"],
      "qualityGate": "rawHtmlExists",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "clean",
      "name": "Clean source HTML",
      "order": 3,
      "description": "Clean raw OpenStax HTML while preserving academic structure.",
      "agent": "agent-scrape",
      "scope": ["chapter", "book-level"],
      "inputPhases": ["scrape"],
      "outputPhase": "clean",
      "inputPaths": ["01-raw"],
      "outputPaths": ["02-clean"],
      "qualityGate": "cleanHtmlValid",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "analyze",
      "name": "Analyze content and glossary",
      "order": 4,
      "description": "Analyze source content, extract terminology, and prepare translation context.",
      "agent": "agent-analyze",
      "scope": ["chapter", "book-level"],
      "inputPhases": ["clean"],
      "outputPhase": "analyzed",
      "inputPaths": ["02-clean", "glossary.csv"],
      "outputPaths": ["03-analyzed"],
      "qualityGate": "analysisCompleteness",
      "requiresHumanApproval": true,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "glossary",
      "name": "Glossary governance and approval",
      "order": 5,
      "description": "Consolidate glossary candidates, run validation, impact analysis, and human approval workflow.",
      "agent": "workflow-core",
      "scope": ["book"],
      "inputPhases": ["analyze"],
      "outputPhase": "glossary",
      "inputPaths": ["chapters/**/03-analyzed/**", "glossary.csv"],
      "outputPaths": ["glossary-candidates.csv", "glossary.csv", "reports/glossary-candidates-report.md"],
      "qualityGate": "glossaryApproval",
      "requiresHumanApproval": true,
      "canRunAutomatically": false,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "prep",
      "name": "Prepare bilingual HTML",
      "order": 6,
      "description": "Create pre-translation bilingual prep files from clean HTML.",
      "agent": "agent-translate",
      "scope": ["chapter", "book-level"],
      "inputPhases": ["clean", "glossary"],
      "outputPhase": "prep",
      "inputPaths": ["02-clean"],
      "outputPaths": ["04-prep"],
      "qualityGate": "prepCompleteness",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "translate",
      "name": "Translate prepared bilingual HTML",
      "order": 7,
      "description": "Translate Vietnamese target blocks using glossary and translation context.",
      "agent": "agent-translate",
      "scope": ["chapter", "book-level"],
      "inputPhases": ["prep", "analyze", "glossary"],
      "outputPhase": "translated",
      "inputPaths": ["04-prep", "03-analyzed", "glossary.csv"],
      "outputPaths": ["05-translated"],
      "qualityGate": "bilingualPairs",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "review",
      "name": "Review translated content",
      "order": 8,
      "description": "Run semantic, glossary, integrity, and review checks on translated HTML.",
      "agent": "agent-review",
      "scope": ["chapter", "book-level"],
      "inputPhases": ["translate"],
      "outputPhase": "reviews",
      "inputPaths": ["05-translated", "glossary.csv"],
      "outputPaths": ["06-reviews", "reports"],
      "qualityGate": "reviewCompleteness",
      "requiresHumanApproval": true,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "archive",
      "name": "Archive reviewed outputs",
      "order": 9,
      "description": "Create archived chapter outputs including VN-only HTML, Markdown, PDF, and assets.",
      "agent": "agent-archive",
      "scope": ["chapter", "book-level"],
      "inputPhases": ["translate", "review"],
      "outputPhase": "archive",
      "inputPaths": ["05-translated", "06-reviews", "assets"],
      "outputPaths": ["07-archive"],
      "qualityGate": "archiveCompleteness",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "build_preview",
      "name": "Build HTML preview",
      "order": 10,
      "description": "Build book-level HTML preview from archived chapter outputs.",
      "agent": "agent-archive",
      "scope": ["book"],
      "inputPhases": ["archive"],
      "outputPhase": "preview",
      "inputPaths": ["chapters/**/07-archive", "_book-level/**/07-archive"],
      "outputPaths": ["preview/html"],
      "qualityGate": "previewCssReferences",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "export_epub",
      "name": "Export EPUB",
      "order": 11,
      "description": "Build EPUB export from archived and preview-ready content.",
      "agent": "agent-archive",
      "scope": ["book"],
      "inputPhases": ["archive", "build_preview"],
      "outputPhase": "epub",
      "inputPaths": ["07-archive", "preview/html"],
      "outputPaths": ["exports/epub/book.epub"],
      "qualityGate": "epubValidity",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "qa_summary",
      "name": "Generate QA summary",
      "order": 12,
      "description": "Generate dataset-level QA summary from available QA reports.",
      "agent": "agent-review",
      "scope": ["book"],
      "inputPhases": ["review", "archive", "build_preview"],
      "outputPhase": "qaSummary",
      "inputPaths": ["reports"],
      "outputPaths": ["qa-summary.json", "qa-summary.md"],
      "qualityGate": "qaSummary",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "generate_state",
      "name": "Generate workflow state",
      "order": 13,
      "description": "Generate workflow-state.json from real dataset structure and QA summary.",
      "agent": "workflow-core",
      "scope": ["book"],
      "inputPhases": ["qa_summary"],
      "outputPhase": "workflowState",
      "inputPaths": ["book.config.json", "qa-summary.json", "reports", "chapters"],
      "outputPaths": ["workflow-state.json"],
      "qualityGate": "workflowStateValid",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    },
    {
      "id": "final_validate",
      "name": "Final validate dataset",
      "order": 14,
      "description": "Run final validation and determine dataset readiness.",
      "agent": "workflow-core",
      "scope": ["book"],
      "inputPhases": ["generate_state"],
      "outputPhase": "finalValidation",
      "inputPaths": ["workflow-state.json", "qa-summary.json", "reports"],
      "outputPaths": ["reports/final-validation-report.json", "reports/final-validation-report.md"],
      "qualityGate": "finalValidation",
      "requiresHumanApproval": false,
      "canRunAutomatically": true,
      "writesDataset": true,
      "readOnly": false,
      "status": "defined"
    }
  ]
}
